# Neon pooled connection string (required by API functions and migration script)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Injected automatically after connecting a separate Vercel Blob store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional Vite dev proxy override. Defaults to the new production deployment.
LOCAL_API_TARGET=https://gnrsmashstats-kohl.vercel.app
